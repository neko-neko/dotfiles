# Server/development-server-only packages for the Tailscale Hermes box.
# Requires the common Brewfile (repo root) to be installed first — see
# setup/install.zsh and README.md "Installation".

# Tailscale connectivity for the Hermes server itself.
brew 'tailscale'

# Reverse engineering — headless/batch analysis (analyzeHeadless). Pairs
# with the interactive `cask 'ghidra'` GUI app in the mac-client layer.
brew 'ghidra', link: false
