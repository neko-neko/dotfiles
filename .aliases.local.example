# ------------------------------
# Mac client local alias overrides (example)
# ------------------------------
# The tracked `aliases` file ships Hermes-server-safe defaults: classic
# grep/ls/cat/top behavior, since colorized/replaced output is noisy for
# piped command output and for AI coding agents reading terminal output on
# the server.
#
# On a Mac client machine, copy this file to re-enable the client-friendly
# versions:
#   cp .aliases.local.example ~/.aliases.local
#
# ~/.aliases.local is sourced automatically at the end of the tracked
# `aliases` file and is NOT tracked by git (machine-specific, lives outside
# this repo in $HOME).

alias grep='grep --color=auto'
alias ls='ls --color'
alias top='btm'
alias cat='bat'
